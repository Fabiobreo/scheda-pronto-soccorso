// Prisma schema — vedi CLAUDE.md per il dominio.
// Una sola entità `Scheda`: campi scalari come colonne, sezioni a righe ripetute
// (parametri, terapie, diario) e sintomi selezionati come Json. Autosave = 1 PUT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SchedaStatus {
  DRAFT
  COMPLETED
}

// Ruoli gerarchici: NURSE < SUPERVISOR < ADMIN. Il confronto gerarchico è in
// src/lib/roles.ts (un valore numerico per livello).
enum Role {
  NURSE
  SUPERVISOR
  ADMIN
}

enum AuditAction {
  CREATE
  UPDATE
  COMPLETE
  DELETE
  RESTORE
  PURGE
  EXPORT
  USER_CREATE
  USER_UPDATE
  USER_DELETE
}

// Log immutabile delle azioni (append-only): nessuna route lo aggiorna o cancella.
// In sanità serve sapere chi ha fatto cosa e quando.
model AuditLog {
  id       String      @id @default(cuid())
  entity   String // "Scheda" | "User"
  entityId String
  action   AuditAction
  userId   String? // attore; null per azioni di sistema
  meta     Json? // dettaglio opzionale (es. campi modificati)
  at       DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId, at])
}

// Utente applicativo. Autenticazione a credenziali (email + password con hash
// bcrypt): sessione JWT, quindi non servono le tabelle Account/Session del
// PrismaAdapter (necessarie solo per OAuth o sessioni su DB).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  role         Role     @default(NURSE)
  disabled     Boolean  @default(false)
  forcePasswordChange Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relazioni di audit verso le schede (attore delle azioni).
  schedeCreate    Scheda[] @relation("SchedaCreatedBy")
  schedeCompletate Scheda[] @relation("SchedaCompletedBy")
  schedeEliminate  Scheda[] @relation("SchedaDeletedBy")
}

model Scheda {
  id     String       @id @default(cuid())
  status SchedaStatus @default(DRAFT)

  // Etichetta riconoscibile per la lista (iniziali / codice intervento).
  riferimento String @default("")

  // Anagrafica / intestazione (date e ore come stringhe, formato input nativo).
  data                 String @default("")
  oraArrivo            String @default("")
  nome                 String @default("")
  cognome              String @default("")
  dataNascita          String @default("")
  sesso                String @default("")
  telefono             String @default("")
  gruppo               String @default("")
  codiceTriage         String @default("")
  oraInizioTrattamento String @default("")
  responsabile         String @default("")

  // Valutazione iniziale (ABCDE) + esito.
  coscienza String @default("")
  vieAeree  String @default("")
  respiro   String @default("")
  circolo   String @default("")
  addome    String @default("")
  esito     String @default("")

  // Patologia prevalente: elenco di codici della tassonomia (vedi src/lib/patologie.ts)
  patologie Json @default("[]")

  // Sintomi (SAMPLE): { [categoriaId]: { codici: string[], note?: string } }
  sintomi Json @default("{}")

  // Monitoraggio parametri: [{ ora, temp, spo2, dolore, pa, fc, fr, hgtt, gcs, rts }]
  parametri Json @default("[]")

  anamnesi               String  @default("")
  terapiaDomiciliare     String  @default("")
  negaTerapiaDomiciliare Boolean @default(false)
  allergie               String  @default("")
  negaAllergie           Boolean @default(false)

  // Terapia somministrata: [{ ora, farmaco, dose, via, note? }]
  terapieSomministrate Json @default("[]")

  // Diario clinico: [{ ora, testo }]
  diario Json @default("[]")

  conclusioni String @default("")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Soft-delete: un record clinico non si distrugge mai (default). La hard-delete
  // resta riservata all'ADMIN dal cestino. Tutte le letture filtrano deletedAt: null.
  deletedAt DateTime?

  // Attori delle azioni (audit a livello di record). Nullable: schede preesistenti
  // all'introduzione dell'auth non hanno un autore noto.
  createdById   String?
  createdBy     User?   @relation("SchedaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedById String?
  completedBy   User?   @relation("SchedaCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  deletedById   String?
  deletedBy     User?   @relation("SchedaDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([status, deletedAt, updatedAt])
}
