# PostgreSQL (Neon in produzione).
# DATABASE_URL: connessione runtime (pooled su Neon, es. ...-pooler...).
# DIRECT_URL: connessione diretta non-poolata, usata da Prisma Migrate.
DATABASE_URL="postgresql://user:password@localhost:5432/scheda_pronto_soccorso?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/scheda_pronto_soccorso?schema=public"

# Auth.js v5 — segreto per firmare i JWT di sessione.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="changeme-generate-a-random-secret"

# Seed del primo amministratore (usato da prisma/seed.ts).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"

# Cron / manutenzione — segreto richiesto da /api/maintenance/purge.
# Su Vercel viene inoltrato automaticamente come header Authorization ai cron job.
CRON_SECRET="changeme-generate-a-random-secret"

# Conservazione dati (opzionali; default 90 / 730 giorni).
# Giorni dopo i quali le schede nel cestino sono eliminate definitivamente.
RETENTION_TRASH_DAYS="90"
# Giorni di conservazione del registro di audit.
RETENTION_AUDIT_DAYS="730"

# Branding struttura (lato client, NEXT_PUBLIC_*).
NEXT_PUBLIC_STRUTTURA_NOME="Nome Associazione"
NEXT_PUBLIC_STRUTTURA_SOTTOTITOLO="Servizio di Pronto Soccorso"
